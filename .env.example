# ---- Server ----
PORT=4000
# Interface to bind. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 only if you know why.
HOST=127.0.0.1
# Public origin of the app (no trailing slash). Must be https:// in production.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DATA_DIR=./data
MAX_UPLOAD_MB=100

# Demo mode seeds sample content and accounts (password: demo-password). NEVER enable in production.
DEMO_MODE=false

# ---- Roles ----
# Comma-separated Google emails that are always Site Admins (via Google sign-in only).
SITE_ADMIN_EMAILS=you@example.com

# ---- Google sign-in (OAuth client, type "Web application") ----
# Authorized redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Multi-Google-Drive storage ----
# Personal Google Drives (OAuth): refresh tokens are stored encrypted with this key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=

# Workspace Shared Drives (optional): path to a service account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
