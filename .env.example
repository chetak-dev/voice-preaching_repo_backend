# ---- Server ----
PORT=4000
# Interface to bind. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 only if you know why.
HOST=127.0.0.1
# Public origin of the app (no trailing slash). Must be https:// in production.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DATA_DIR=./data
# Hosted database (required on Vercel). Leave empty to use a local SQLite file in DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Number of reverse proxies in front of the app (Caddy, nginx, hosting platform). Defaults to 1 in production.
# TRUST_PROXY=1

# ---- Roles ----
# Comma-separated Google emails that are always Site Admins (via Google sign-in only).
SITE_ADMIN_EMAILS=you@example.com

# ---- Google sign-in (OAuth client, type "Web application") ----
# Authorized redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Multi-Google-Drive storage ----
# Personal Google Drives (OAuth): refresh tokens are stored encrypted with this key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=

# Workspace Shared Drives (optional): path to a service account JSON key,
# or (on Vercel) paste the whole key JSON into GOOGLE_SERVICE_ACCOUNT_JSON instead.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Legal pages ----
# Contact email shown on the Privacy Policy and Terms pages (build-time). Leave empty to say "contact a site administrator".
VITE_CONTACT_EMAIL=
