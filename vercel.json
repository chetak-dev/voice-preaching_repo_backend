{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }, { "source": "/s/(.*)", "destination": "/api" }, { "source": "/share-target", "destination": "/api" }],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/backup", "schedule": "30 21 * * *" }]
}
